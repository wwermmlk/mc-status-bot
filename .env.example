# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# ===== 디스코드 =====
# Discord Developer Portal > Bot > Reset Token 에서 발급 (필수)
DISCORD_TOKEN=여기에_봇_토큰

# 슬래시 커맨드를 즉시 등록할 서버(길드) ID. 비워두면 글로벌 등록(반영까지 최대 1시간)
GUILD_ID=

# 상태 보드를 표시할 채널 ID (필수)
STATUS_CHANNEL_ID=

# ===== 마인크래프트 서버 =====
# 서버 주소 (필수)
MC_HOST=play.example.com
MC_PORT=25565
# server.properties의 query.port 값 (보통 MC_PORT와 동일)
MC_QUERY_PORT=25565

# ===== 상태 보드 =====
# 갱신 주기(초). 디스코드 메시지 수정 제한 때문에 최소 15초
UPDATE_INTERVAL=30

# 봇 프로필에 "플레이 중 N명 온라인" 표시. 끄려면 false
PRESENCE_UPDATE=true

# 봇이 돌고 있는 위치. 푸터에서 핑을 어디서 잰 값인지 밝히는 데 쓴다
BOT_LOCATION=오사카

# ===== 서버 홈페이지 (선택) =====
# 설정하면 임베드 설명에 홈페이지의 대표 문구(강조 줄)와 링크를 표시한다.
# 비워두면 서버 MOTD를 그대로 쓴다.
SITE_URL=
# 홈페이지 문구를 다시 읽어오는 주기(초)
SITE_CACHE_SECONDS=600
# 임베드에 표시할 홈페이지 링크 문구. 비우면 링크를 넣지 않는다
SITE_LINK_TEXT=🏡 서버 홈페이지

# 봇 프로필에 표시될 설명. 비워두면 기존 설명을 건드리지 않음
BOT_DESCRIPTION=

# ===== TPS 표시 (선택) =====
# 채우면 상태 보드에 서버 성능(TPS)을 표시합니다.
# RCON은 비밀번호를 평문으로 보냅니다. 포트포워딩하지 말고 Tailscale 등 사설망 주소(100.x)만 쓰세요.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=


# ══════════ 채팅 브리지 (bridge.py) — 마인크래프트 서버 PC에서만 필요 ══════════

# 브리지가 사용할 봇 토큰 (필수). 상태 봇 토큰을 그대로 써도 되고, 분리해도 됩니다
# 개발자 포털 > Bot 에서 MESSAGE CONTENT INTENT 를 켜야 합니다
BRIDGE_DISCORD_TOKEN=

# 게임 채팅을 주고받을 채널 ID (필수)
BRIDGE_CHAT_CHANNEL_ID=
# 콘솔 로그를 올릴 비공개 채널 ID. 비우면 로그 전송을 하지 않음
BRIDGE_LOGS_CHANNEL_ID=

# 서버 폴더 안의 로그 파일 경로 (필수)
MC_LOG_PATH=C:\minecraft\server\logs\latest.log

# server.properties 의 enable-rcon=true / rcon.port / rcon.password 와 맞춰주세요
# RCON은 같은 PC(127.0.0.1)에서만 사용합니다. 공유기에서 25575 포트를 열지 마세요.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# 디스코드 서버 소유자가 #chat 에 쓴 메시지의 게임 내 닉네임 색 (#RRGGBB). 비우면 금색 #FFAA00
OWNER_NAME_COLOR=

# #chat 에 표시할 플레이어 얼굴 이미지 주소. {name} 이 플레이어 이름으로 바뀜. 비우면 minotar 사용
AVATAR_URL=

# #logs 에 올릴 때 플레이어 IP를 가림
LOG_MASK_IPS=true
# #logs 로 묶어서 보내는 간격(초)
LOG_FLUSH_SECONDS=2
